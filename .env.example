# ============================================================
#  Мөлдір өлең — переменные окружения
#  Скопируйте в .env.local (локально) и в Vercel → Settings → Environment Variables
# ============================================================

# --- База данных (Supabase) -------------------------------------------------
# Supabase → Project Settings → Database → Connection string → "Connection pooling"
# Берите строку в режиме Transaction (порт 6543) — она нужна для serverless.
DATABASE_URL="postgresql://postgres.xxxxxxxx:PASSWORD@aws-0-eu-central-1.pooler.supabase.com:6543/postgres"

# --- ApiPay (Kaspi Pay) -----------------------------------------------------
APIPAY_BASE_URL="https://api.apipay.kz/api/v1"
APIPAY_API_KEY=""

# Секрет подписи webhook'а — ОТДЕЛЬНОЕ значение, не API-ключ.
# Кабинет ApiPay → Настройки → «Подключение» → изменить ключ → «Адрес уведомлений».
# Пока пусто, обработчик отклоняет все webhook'и. Это защита, а не поломка.
APIPAY_WEBHOOK_SECRET=""

# offline — в ApiPay не ходим совсем; оплата подтверждается локально.
#           Годится, чтобы посмотреть сайт без ключей.
# sandbox — реальные вызовы ApiPay с ключом в ТЕСТ-режиме. Оплата проводится
#           через POST /invoices/{id}/simulate-status и приходит настоящим
#           подписанным webhook'ом — проверяется боевой путь целиком.
# live    — боевые счета в Kaspi.
PAYMENTS_MODE="sandbox"
NEXT_PUBLIC_PAYMENTS_MODE="sandbox"

# --- Админка ----------------------------------------------------------------
# Пароль для входа на /admin
ADMIN_PASSWORD=""
# Секрет подписи сессионной cookie. Сгенерировать:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SESSION_SECRET=""

# --- Адрес сайта ------------------------------------------------------------
# Нужен для формирования адреса webhook'а, который вы укажете в кабинете ApiPay:
#   {NEXT_PUBLIC_SITE_URL}/api/webhooks/apipay
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
