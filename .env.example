# ============================================================
#  Мөлдір өлең — переменные окружения
#  Скопируйте в .env.local и заведите те же в Vercel → Settings → Environment Variables
# ============================================================

# --- База данных (Supabase) -------------------------------------------------
# Supabase → Project Settings → Database → Connection string → Transaction pooler
# Обязательно порт 6543: на serverless прямое подключение исчерпает пул.
# Если в пароле есть % или $ — они кодируются как %25 и %24.
DATABASE_URL=""

# --- Админка ----------------------------------------------------------------
# Пароль для входа на /admin
ADMIN_PASSWORD=""
# Секрет подписи сессионной cookie. Сгенерировать:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SESSION_SECRET=""

# --- Адрес сайта ------------------------------------------------------------
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ============================================================
#  Всё остальное правится в админке, а не здесь:
#    — города, их ссылки Kaspi, порядок и цвета
#    — цена голоса
#    — номер WhatsApp для скриншотов
#    — тексты на страницах
